rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // P0.2: Helper to exclude sensitive fields from non-admin users
    function excludeSensitiveFields(data) {
      return {
        name: data.name,
        cnpj: data.cnpj,
        cpf: data.cpf,
        phone: data.phone,
        email: data.email,
        address: data.address,
        number: data.number,
        city: data.city,
        state: data.state,
        zipCode: data.zipCode,
        neighborhood: data.neighborhood,
        inscricaoMunicipal: data.inscricaoMunicipal,
        inscricaoEstadual: data.inscricaoEstadual
      };
    }

    function excludeNFSeSecrets(data) {
      return {
        enabled: data.enabled,
        provider: data.provider,
        environment: data.environment,
        cityCode: data.cityCode,
        serviceCode: data.serviceCode,
        cnaeCode: data.cnaeCode,
        aliqIss: data.aliqIss,
        certificateName: data.certificateName
        // certificate, certificatePassword, apiKey are EXCLUDED
      };
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Clients collection
    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'staff']);
    }

    // Services collection
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Appointments collection
    match /appointments/{appointmentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'staff']);
    }

    // Staff collection
    match /staff/{memberId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Financial records collection
    match /financialRecords/{recordId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // NFSe records collection
    match /nfseRecords/{nfseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Settings collection - P0.2: Only admins can read/write; non-admins get filtered data
    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Reports collection
    match /reports/{reportId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
